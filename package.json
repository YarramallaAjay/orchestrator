{
  "name": "@ajayyarramalla/orchestrator",
  "version": "0.5.0",
  "description": "Multi-agent development orchestrator — autonomous task planning, execution, and validation with Claude Code integration",
  "keywords": [
    "orchestrator",
    "multi-agent",
    "claude",
    "claude-code",
    "automation",
    "task-runner",
    "ai-agent"
  ],
  "homepage": "https://github.com/YarramallaAjay/orchestrator#readme",
  "bugs": {
    "url": "https://github.com/YarramallaAjay/orchestrator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YarramallaAjay/orchestrator.git"
  },
  "license": "MIT",
  "author": "ajayyarramalla",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "orch": "dist/index.js"
  },
  "directories": {
    "test": "tests"
  },
  "files": [
    "dist",
    "CLAUDE.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
"typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.270",
    "@anthropic-ai/claude-code": "^2.1.269",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "minimatch": "^10.0.1",
    "nanoid": "^5.1.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "yaml": "^2.7.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
